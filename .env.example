# DFIR Evidence Workbench - non-secret environment template
# Copy to .env (gitignored) and adjust for your environment.
#
# SECRETS RULE (mandatory):
# - Never commit real credentials, passwords, tokens, keys, or DATABASE_URL with values.
# - Secrets MUST come exclusively from the host environment, podman/docker secrets,
#   secret managers (e.g. Vault, Azure Key Vault, AWS SM), or orchestrator injection.
# - .env and compose files contain only placeholders, dev defaults, or non-secret config.
# - DATABASE_URL (which embeds password) is injected via DFIRWB_DATABASE_URL only.
# - In production use secret _FILE conventions or direct secret mounts; never env vars
#   containing secrets if logs/inspect can leak them.
#
# See compose.prod.yaml and docs for production patterns.
# See security-defensibility-requirements.md (REQ-SEC-*) and SECURITY.md .
#
# LAN / trusted dev: after copy+edit, use `podman compose -f compose.lan.yaml up -d`
# (explicit 0.0.0.0; plain HTTP only for synthetic trusted-LAN testing per lan-development-exposure skill).
# Default compose.yaml is always 127.0.0.1 (localhost).
# Do not publish or firewall-open without understanding the limitations (no TLS, synthetic only).
# Verify with: curl http://<lan-ip>:8080/healthz from another host on LAN.
#
# To use non-default published ports (to avoid conflicts or for testing):
#   API_PUBLISH=127.0.0.1:18080 POSTGRES_PUBLISH=127.0.0.1:15432 podman compose ...
# For LAN: API_PUBLISH=0.0.0.0:18080 ... podman compose -f compose.lan.yaml ...
#
# Production: DFIRWB_ENV=prod (disables synthetic/dev routes), real auth, TLS front,
# external secret injection, no dev volumes.
#
# Dev convenience (override via .env or export):
DFIRWB_ENV=dev
DFIRWB_HOST=127.0.0.1
DFIRWB_PORT=8080
DFIRWB_LOG_LEVEL=info

# Dev-only synthetic tenant (explicitly labeled; absent from prod responses and schema)
DFIRWB_SYNTHETIC_TENANT=synthetic-dev-org

# PostgreSQL connection for compose (internal service hostname 'postgres'):
# This value is the ONLY place the secret appears for dev stack. Never in compose.yaml.
# For compose: use the service name in URL.
DFIRWB_DATABASE_URL=postgresql://dfir:dfir-dev-pass@postgres:5432/dfir_dev
# For native local API (outside compose): DFIRWB_DATABASE_URL=postgresql://dfir:dfir-dev-pass@127.0.0.1:5432/dfir_dev

# Compose convenience vars (used by compose.yaml interpolation for the *postgres service only*; override in .env)
POSTGRES_USER=dfir
POSTGRES_PASSWORD=dfir-dev-pass
POSTGRES_DB=dfir_dev

# Optional publish overrides (host:container published). See above.
# API_PUBLISH=127.0.0.1:8080
# POSTGRES_PUBLISH=127.0.0.1:5432
